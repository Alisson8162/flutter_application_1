# ============================
# Servidor
# ============================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================
# Banco de dados (PostgreSQL)
# ============================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=81626678@Li
PG_DATABASE=falacomigo
# Alternativa: uma única connection string (sobrepõe as opções acima se definida)
# PG_CONNECTION_STRING=postgres://user:password@host:5432/falacomigo
PG_SSL=false

# ============================
# JWT
# ============================
JWT_SECRET=troque_este_valor_por_uma_string_secreta_bem_grande_e_aleatoria
JWT_EXPIRES_IN=7d

# ============================
# Cloudinary (upload de imagens/documentos)
# ============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================
# E-mail (SMTP)
# ============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ============================
# SMS (Twilio) - opcional, simulado se vazio
# ============================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================
# Stripe (pagamentos)
# ============================
# Chaves de teste em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Gerado pelo Stripe CLI (stripe listen --forward-to localhost:5000/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_SUBSCRIPTION_AMOUNT_CENTS=4990

# ============================
# Firebase Admin (push notifications / FCM)
# ============================
# Uma das duas: caminho pro arquivo .json baixado no Firebase Console, OU o
# conteúdo inteiro do JSON como string (útil em ambientes sem filesystem
# persistente). Ver config/firebase.js.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================
# Redis (rate limiting compartilhado entre instâncias)
# ============================
# Sem isso definido, o rate limiting funciona normalmente mas cada instância
# do backend guarda seus próprios contadores (ok para 1 instância, não
# recomendado com mais de uma atrás de um load balancer). Ver
# config/redis.js. Com docker-compose, use: redis://redis:6379
REDIS_URL=

# ============================
# Sentry (monitoramento de erros em produção)
# ============================
# Sem isso definido, erros continuam sendo logados no console normalmente,
# só não são enviados para lugar nenhum. Ver config/sentry.js.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
